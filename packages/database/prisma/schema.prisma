generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  name     String
  image    String?
  meetings Meeting[]
}

model Meeting {
  id          String  @id @default(uuid())
  meetingCode String  @unique
  title       String?
  user        User    @relation(fields: [userId], references: [id])
  userId      Int
}
